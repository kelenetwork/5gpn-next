{
  "gateway": {
    "listen": ":20443",
    "host": "gateway.example.com",
    "cert_file": "/etc/letsencrypt/live/gateway.example.com/fullchain.pem",
    "key_file": "/etc/letsencrypt/live/gateway.example.com/privkey.pem",
    "profile_path": "/dl/REPLACE_RANDOM/5gpn-next.mobileconfig"
  },
  "egress": [
    { "name": "DIRECT", "type": "direct" }
  ],
  "rules": [],
  "final": "direct",
  "rulesets": [
    {
      "name": "cn-domain",
      "kind": "domain",
      "interval_hours": 24,
      "url": "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/direct-list.txt"
    },
    {
      "name": "geoip:cn",
      "kind": "ipcidr",
      "interval_hours": 24,
      "url": "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/text/cn.txt"
    }
  ],
  "ad_block": {
    "enabled": false,
    "allowlist": []
  },
  "bot": {
    "token": "",
    "admins": []
  },
  "panel": {
    "enabled": true
  },
  "dns": {
    "enabled": true,
    "dot_listen": ":853",
    "gateway_ip": "172.22.0.1",
    "http_listen": ":80",
    "tls_listen": ":443",
    "upstream": ["223.5.5.5:53", "119.29.29.29:53"]
  },
  "update": {
    "check_enabled": true,
    "interval_hours": 1,
    "auto_apply": false
  },
  "prefer_ipv4": true,
  "client_cidr": "172.22.0.0/16",
  "log_path": "/var/log/5gpn-next/trace.jsonl"
}
